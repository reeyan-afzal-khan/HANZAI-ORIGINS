.claude/
node_modules/
/release/*
!/release/android/
!/release/web/
extracted/
tools/local/
release/android/www/
release/android/local.properties
release/android/.gradle/
release/android/build/
release/android/app/build/
release/android/capacitor-cordova-android-plugins/
# macOS leaves these behind on any folder it has touched: .DS_Store holds the
# Finder's view settings, and every ._name file is the resource fork of the
# file beside it. Both are noise here, and a folder copied over from a Mac
# can carry one for every file in it, doubling the tree for nothing.
.DS_Store
._*

# Signing material. Losing keys/*.jks means never shipping an update to
# anyone who installed a build signed with it — back it up somewhere safe.
release/android/keys/
release/android/keystore.properties

# The generated store. Rebuilt from src/data/ by `npm run db` in a couple of
# seconds, so a 20 MB binary that changes wholesale on every build does not
# need to be in the history. Everything it is built from is committed, and
# everything the app loads is exported out of it into release/web/data/.
src/data/hskker.db
src/data/hskker.db-journal

# Source documents — .docx and PDFs — and the font sources are never in the
# repository: what is built from them is.
src/data/**/*.pdf
src/data/**/*.docx

# The offline translator: about 135 MB as published (src/data/translation/) and
# 180 MB as the scripts the app loads (release/web/data/mt/). `npm run translation`
# fetches the first, checks it and makes the second; see
# src/data/translation/README.md.
src/data/translation/runtime/
src/data/translation/opus-mt-zh-en/
release/web/data/mt/
